# API and worker secrets. Copy to .env (git-ignored) at the repository root.
# The API refuses to start if any of these is missing (app.core.config).

MISTRAL_API_KEY=
# Created in the RAGFlow UI (avatar -> API) after first start; see infra/ragflow/README.md.
RAGFLOW_API_KEY=

# Host-run API (uv run uvicorn ...). Inside Compose these are set by infra/compose.dev.yml.
DATABASE_URL=postgresql+asyncpg://askspore:askspore-dev@127.0.0.1:5432/askspore
REDIS_URL=redis://127.0.0.1:6379/0

# Optional: directory holding models.toml and prompts/ (defaults to <repo>/config).
# ASK_SPORE_CONFIG_DIR=

# API and worker secrets. Copy to .env (git-ignored) at the repository root.
# The API refuses to start if any of these is missing (app.core.config).

# LLM provider key: the one named by [llm] provider in config/models.toml is required.
MISTRAL_API_KEY=
# Scaleway Generative APIs (Phase 0 provider, findings M2): an IAM secret key whose policy
# allows Generative APIs in fr-par. Optional SCALEWAY_PROJECT_ID (a project UUID) scopes
# the endpoint to that project for billing: https://api.scaleway.ai/<project-id>/v1.
SCALEWAY_API_KEY=
SCALEWAY_PROJECT_ID=
# OpenRouter (P1a-10): external (non-EU) models for entitled tenants only. Optional:
# without it every external model is refused. Do not set it before the OpenRouter DPA,
# SCCs and the transfer impact assessment are filed (P1a-15).
OPENROUTER_API_KEY=
# Platform mail (P1b-11), [mail] in config/models.toml. Optional: without the active
# provider's key nothing is sent (send_mail jobs fail with mail_not_configured).
# Scaleway Transactional Email (fr-par, the primary): a separate IAM key whose policy
# allows Transactional Email (EmailSend) on the sending project only, not the Generative
# APIs key above. The project defaults to SCALEWAY_PROJECT_ID.
SCALEWAY_TEM_API_KEY=
SCALEWAY_TEM_PROJECT_ID=
# Mailgun EU (the backup): only with [mail] provider = "mailgun", after its DPA is filed.
MAILGUN_API_KEY=
# Authentication: [auth] mode in config/models.toml picks one; only its secrets are needed.
# mode = "phase0" (P0-06, kept for the eval harness): one bearer token shared by the team,
# at least 32 characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Requests also send X-User-Email naming a user from PHASE0_INTERNAL_USERS.
PHASE0_BEARER_TOKEN=
# mode = "oidc" (P1a-02): the confidential client secret of the Authentik provider
# "ask-spore", and an Authentik API token allowed to manage users (infra/authentik/README.md).
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_API_TOKEN=
# Created in the RAGFlow UI (avatar -> API) after first start; see infra/ragflow/README.md.
RAGFLOW_API_KEY=

# Seeded into the internal tenant by the first migration: comma-separated
# "email:Display Name" pairs. Only these users can use the Phase 0 API.
PHASE0_INTERNAL_USERS=

# Host-run API and Alembic (uv run ...). Inside Compose these are set by
# infra/compose.dev.yml. The API connects as askspore_app (not the table owner, so
# row-level security applies); migrations run as the owner.
DATABASE_URL=postgresql+asyncpg://askspore_app:askspore-app-dev@127.0.0.1:5432/askspore
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://askspore:askspore-dev@127.0.0.1:5432/askspore
REDIS_URL=redis://127.0.0.1:6379/0

# Database tests (apps/api/tests): a superuser DSN; each run creates and drops its
# own database.
# TEST_ADMIN_DATABASE_URL=postgresql://askspore:askspore-dev@127.0.0.1:5432/postgres

# Optional: directory holding models.toml and prompts/ (defaults to <repo>/config).
# ASK_SPORE_CONFIG_DIR=

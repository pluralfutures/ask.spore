# Authentik (P1a-02). Copy to infra/authentik/.env (git-ignored) and fill in; read as
# container environment by infra/authentik/docker-compose.yml (profile "auth").
# Generate secrets with: openssl rand -base64 36 | tr -d '\n'

# Authentik's own Postgres: the same value twice (database container, Authentik).
POSTGRES_PASSWORD=
AUTHENTIK_POSTGRESQL__PASSWORD=
AUTHENTIK_SECRET_KEY=

# Outbound SMTP relay, STARTTLS on port 587 (owner decision Oct 20, 2026: Scaleway
# Transactional Email is the primary, Mailgun EU the optional backup; the API only ever
# talks to one of them, switch by editing these lines and restarting the auth profile).
#
# Primary: Scaleway Transactional Email, region fr-par. The sending domain must be added
# and verified in the Scaleway console (Transactional Email, fr-par: SPF, DKIM, MX, and a
# DMARC record). Username = the Scaleway Project ID; password = an IAM API secret key
# whose policy allows TransactionalEmailFullAccess (or EmailSend) on that project. Never
# the account's main key. Check the project's sending quota in the console before the
# first client onboarding.
AUTHENTIK_EMAIL__HOST=smtp.tem.scw.cloud
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__FROM=
#
# Backup: Mailgun, EU region only (never the US one). Host smtp.eu.mailgun.org, port 587.
# Username and password are an SMTP credential created on the sending domain in Mailgun;
# never the account API key. The domain must be verified (SPF, DKIM, DMARC) with click
# and open tracking switched off. Use only after the Mailgun DPA is filed (P1a-15).
# AUTHENTIK_EMAIL__HOST=smtp.eu.mailgun.org
# AUTHENTIK_EMAIL__PORT=587

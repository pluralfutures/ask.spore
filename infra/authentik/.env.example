# Authentik (P1a-02). Copy to infra/authentik/.env (git-ignored) and fill in; read as
# container environment by infra/authentik/docker-compose.yml (profile "auth").
# Generate secrets with: openssl rand -base64 36 | tr -d '\n'

# Authentik's own Postgres: the same value twice (database container, Authentik).
POSTGRES_PASSWORD=
AUTHENTIK_POSTGRESQL__PASSWORD=
AUTHENTIK_SECRET_KEY=

# Mailgun, EU region, SMTP with STARTTLS on smtp.eu.mailgun.org:587. The username and
# password are an SMTP credential created on the sending domain in Mailgun (EU region,
# not the US one); never the account API key. The sending domain must be verified in
# Mailgun (SPF, DKIM, DMARC) with click and open tracking switched off.
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__FROM=

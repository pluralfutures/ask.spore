# Phase 1a release: one host with TLS (release runbook section 3).
# No access log: paths under /api/v1/files/ carry single-use download tokens (P1a-14).
# Caddy writes no access log unless a `log` directive is present; do not add one.
{
	email daniel@myceliumgastronomy.com
	admin off
}

# P2A-11: the trust page's two states. The deploy-time flag ASKSPORE_TRUST_PAGE (Compose
# passes it from infra/.env, default "unpublished") picks one when Caddy reads this file.
# Any other value names no snippet and Caddy refuses to start.
(trust_page_unpublished) {
	respond 404
}
(trust_page_published) {
	root * /srv/web
	header Cache-Control "no-cache"
	rewrite * /trust.html
	file_server
}

# P2A-L2: the legal pages (/legal and the four documents), all four on one deploy-time flag
# ASKSPORE_LEGAL ("published" or the default "unpublished", from infra/.env). The argument
# names the file under /srv/web/legal. Any other value names no snippet and Caddy refuses to
# start.
(legal_unpublished) {
	respond 404
}
(legal_published) {
	root * /srv/web
	header Cache-Control "no-cache"
	rewrite * /legal/{args[0]}.html
	file_server
}

askspore.myceliumgastronomy.com {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy api:8000
	}

	# P1b-07: a tenant's IdP sends the browser back to Authentik's callback paths on this
	# host (the redirect URI and SAML ACS URL the client registered). The API takes them
	# and relays the answer to Authentik on the Compose network; nothing else of
	# Authentik is reachable from outside.
	@sso_oauth path_regexp sso_oauth ^/source/oauth/callback/([a-z0-9-]+)/$
	handle @sso_oauth {
		rewrite * /api/v1/auth/sso/oauth/{re.sso_oauth.1}?{query}
		reverse_proxy api:8000
	}
	@sso_saml path_regexp sso_saml ^/source/saml/([a-z0-9-]+)/acs/$
	handle @sso_saml {
		rewrite * /api/v1/auth/sso/saml/{re.sso_saml.1}
		reverse_proxy api:8000
	}

	# P2A-11: public files, served from the web build as plain files, outside the
	# application, its sign-in and its consent gate (no index.html, no API call).
	handle /.well-known/security.txt {
		root * /srv/web
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-cache"
		file_server
	}
	handle /security-disclosure {
		root * /srv/web
		header Cache-Control "no-cache"
		rewrite * /security-disclosure.html
		file_server
	}
	# Not published until the owner clears paperwork item 4 and sets the flag (above).
	handle /trust {
		import trust_page_{$ASKSPORE_TRUST_PAGE:unpublished}
	}
	# P2A-L2: the footer's Legal link and the four documents it lists. Not published until
	# the owner has the texts signed off and sets the flag (above). Public, like the privacy
	# notice must be: no sign-in, no cookie, no API call.
	@legal_index path /legal /legal/
	handle @legal_index {
		import legal_{$ASKSPORE_LEGAL:unpublished} index
	}
	handle /legal/privacy {
		import legal_{$ASKSPORE_LEGAL:unpublished} privacy
	}
	handle /legal/ai {
		import legal_{$ASKSPORE_LEGAL:unpublished} ai
	}
	handle /legal/terms {
		import legal_{$ASKSPORE_LEGAL:unpublished} terms
	}
	handle /legal/sub-processors {
		import legal_{$ASKSPORE_LEGAL:unpublished} sub-processors
	}
	# One address per page: the files' own names are not served.
	@public_page_files path /security-disclosure.html /trust.html /legal/index.html /legal/privacy.html /legal/ai.html /legal/terms.html /legal/sub-processors.html
	handle @public_page_files {
		respond 404
	}

	# The production web build (apps/web/Dockerfile), including /auth/finish: client-side
	# routes fall back to index.html.
	handle {
		root * /srv/web
		@assets path /assets/*
		@pages not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @pages Cache-Control "no-cache"
		# A missing asset is a 404, never index.html under an immutable cache header.
		handle @assets {
			file_server
		}
		handle {
			try_files {path} /index.html
			file_server
		}
	}
}

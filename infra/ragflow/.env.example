# RAGFlow stack settings. Copy to infra/ragflow/.env (git-ignored) and replace
# every change-me value. Derived from the upstream docker/.env at the tag in VERSION,
# reduced to what infra/ragflow/docker-compose.yml uses.

# Read by RAGFlow's service_conf.yaml.template inside the container.
ELASTIC_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MINIO_USER=rag_flow
MINIO_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Elasticsearch memory limit in bytes (upstream default ~8 GB).
MEM_LIMIT=8073741824

# Embedding model served by the TEI container. Must be one baked into
# infiniflow/text-embeddings-inference (upstream options: Qwen/Qwen3-Embedding-0.6B,
# BAAI/bge-m3, BAAI/bge-small-en-v1.5). bge-m3 is multilingual, which the
# corpus needs; bge-small-en-v1.5 is English-only and only for low-memory laptops.
TEI_MODEL=BAAI/bge-m3

# Loopback port for the RAGFlow web UI.
RAGFLOW_UI_PORT=8080

# Upstream defaults to Asia/Shanghai.
TZ=Europe/Paris

# Allow the first account to self-register in the RAGFlow UI, then set to 0.
REGISTER_ENABLED=1
